# ============================================
# 银杏 (Yinxing Monkey) 本地开发环境配置
# ============================================
# 复制此文件为 .env 并根据需要修改

# ---- Webpack Dev Server ----
# 开发时 webpack-dev-server 的地址
DEV_SERVER_URL=http://localhost:8080

# ---- Chrome DevTools Protocol ----
# 调试 Chrome 的远程调试端口地址
CDP_URL=http://127.0.0.1:9222

# ---- Tampermonkey 脚本名称 ----
# 用于在 TM storage 中定位脚本
TM_SCRIPT_NAME=银杏

# ---- 115 云盘目录 ID ----
# 入口目录（全部文件根目录）
ENTRY_PARENT_ID=1153737365202791679
# 视频文件目标目录
VIDEO_TARGET_ID=1214716263562079924
# ISO 文件目标目录
ISO_TARGET_ID=1227621927028387453

# ---- 元数据 API ----
# 番号查询 API 地址
METADATA_API_URL=https://yinxing.av2.us/v1/search
# 影片匹配 API 地址
MOVIE_API_URL=http://yinxing.com/v1/movies

# ---- CDN 发布 ----
# 发布时生成的 @require CDN 地址模板
# {{version}} 会被替换为发布版本号
CDN_REQUIRE_URL=https://cdn.jsdelivr.net/npm/yinxing.monkey@{{version}}/lib/index.js
