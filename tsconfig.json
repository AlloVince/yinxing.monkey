{
  "compilerOptions": {
    "rootDir": "./src/",
    "outDir": "./dist/",
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "removeComments": false,
    "skipLibCheck": true,
    "target": "es2023"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "webpack"
  ]
}